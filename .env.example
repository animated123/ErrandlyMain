# External Integrations
VITE_MAIN_SERVER_URL=https://gateway.errandly.site
VITE_ACTION_SERVER_URL=https://gateway.errandly.site
VITE_GATEWAY_URL=https://gateway.errandly.site

# PostgreSQL Configuration
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin
PGDATABASE=Errandly

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_ID=
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_ROUTES_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Configuration
GEMINI_API_KEY=

# Cloudinary Configuration
CLOUDINARY_URL=
TEXTSASA_API_TOKEN=
TEXTSASA_API_ENDPOINT=https://api.textsasa.com/api/v1/
TEXTSASA_SENDER_ID=
TALKSASA_API_TOKEN=
TALKSASA_API_ENDPOINT=https://bulksms.talksasa.com/api/v3/
TALKSASA_SENDER_ID=

# Email Configuration
# Use either SMTP or Resend API
RESEND_API_KEY=

# SMTP Configuration
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# For Outlook: Use an App Password or ensure STARTTLS is supported
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Paystack Configuration
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# WhatsApp (WaSender API) Configuration
WASENDER_API_KEY=
WASENDER_API_ENDPOINT=https://www.wasenderapi.com/api/send-message

# Rate Limiter & Protection Configuration
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_PAYMENT_WINDOW_MS=60000

